# Required for production: generate a long random value and keep this file private.
JWT_SECRET=replace-with-at-least-32-random-bytes
DEBUG=true

# Optional managed database. Use a Supabase service-role key only on this server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PATH=./tourix.db

# Development-only: DEBUG=true with free shows the prototype OTP in the app. Never use this mode in production.
SMS_PROVIDER=free
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Optional Twilio alternative.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP email via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional operational notification sinks for SOS alerts.
EMERGENCY_DISPATCH_SMS_TO=
EMERGENCY_DISPATCH_EMAIL_TO=

# Optional road routing. Without a key, the backend returns a labeled straight-line estimate.
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_KEY=
